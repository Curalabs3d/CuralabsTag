# Porta do servidor
PORT=4000

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao

NODE_ENV=development

# Caminho do arquivo SQLite (usado quando DATABASE_URL não é definido)
SQLITE_PATH=./data/curalabs3d.db

# --- Opcional: Supabase / Postgres ---
# Se preenchido, o backend pode ser adaptado para usar Postgres + RLS
# em vez do SQLite local (ver README > "Migrando para Supabase").
# DATABASE_URL=postgresql://usuario:senha@host:5432/curalabs3d
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Domínio base usado para montar os links públicos dos chaveiros NFC
PUBLIC_BASE_URL=https://nfc.curalabs3d.com.br
