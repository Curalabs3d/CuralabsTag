# Porta do servidor
PORT=4000

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao

NODE_ENV=development

# --- Banco de dados (Postgres / Supabase) ---
# Use a role dedicada "app_backend" (não a "postgres" padrão), para que as
# políticas de RLS sejam de fato aplicadas pelo banco. Formato:
# postgresql://app_backend:SENHA@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://app_backend:SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# Domínio base usado para montar os links públicos dos chaveiros NFC
PUBLIC_BASE_URL=https://nfc.curalabs3d.com.br

# --- E-mail transacional (recuperação de senha) ---
# Crie uma conta em https://resend.com, verifique o domínio curalabs3d.com.br
# e gere uma API key em Resend > API Keys.
RESEND_API_KEY=
EMAIL_FROM=CuraLabs3D <no-reply@curalabs3d.com.br>

# --- Cobrança recorrente (Mercado Pago) ---
# Crie uma conta em https://www.mercadopago.com.br/developers e gere um
# Access Token em Suas integrações > Credenciais de produção.
# Sem essa variável, a cobrança fica desabilitada mas o resto do sistema
# continua funcionando normalmente (assinaturas ficam em modo manual,
# ajustável pelo Super Admin).
MERCADOPAGO_ACCESS_TOKEN=
